{
  "name": "deepseek-harness-cli",
  "version": "0.1.0",
  "description": "DeepSeek Harness - OpenTUI terminal interface",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "dsh-tui": "bin/dsh-tui"
  },
  "scripts": {
    "dev": "bun run --preload @opentui/solid/preload src/cli.tsx",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload"
  },
  "dependencies": {
    "@opentui/core": "0.1.101",
    "@opentui/solid": "0.1.101",
    "solid-js": "1.9.11"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
