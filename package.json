{
  "name": "deepseek-harness-cli",
  "version": "0.1.0",
  "description": "DeepSeek Harness CLI — an OpenCode-style terminal client for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "deepseek-harness-cli": "dist/cli.js",
    "dsh-cli": "dist/cli.js",
    "dsh-tui": "dist/cli.js",
    "dsh-tui-opencode": "dist/bridge-tui.js"
  },
  "main": "dist/cordis.js",
  "exports": {
    ".": "./dist/cordis.js",
    "./cordis": "./dist/cordis.js",
    "./startup": "./dist/cordis.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "dev": "node scripts/build.mjs --watch",
    "mock": "node scripts/mock-server.mjs",
    "headless": "node dist/cli.js",
    "bridge": "pnpm --filter @dsh/bridge dev",
    "bridge:build": "pnpm --filter @dsh/bridge build",
    "bridge:test": "pnpm --filter @dsh/bridge test",
    "tui": "pnpm --filter @dsh/bridge tui",
    "dsh-tui": "node dist/cli.js",
    "dsh-tui:opencode": "node dist/bridge-tui.js",
    "dsh-tui:build": "pnpm --filter @dsh/tui build"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
