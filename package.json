{
  "name": "@ai-thinker/deepseek-harness-cli",
  "version": "0.3.3",
  "description": "DeepSeek Harness - OpenTUI terminal interface",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/runner.js",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/runner.js",
    "./startup": "./dist/startup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "bin",
    "cordis.patch.yml",
    "dist",
    "scripts/self-update.mjs",
    "vendor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-cli": "bin/dsh-cli",
    "deepseek-harness-cli": "bin/dsh-cli"
  },
  "scripts": {
    "dev": "bun run --preload @opentui/solid/preload src/cli.tsx",
    "dev:debug": "DSH_DEBUG=1 bun run --preload @opentui/solid/preload src/cli.tsx",
    "icons": "bun run scripts/icons.mjs",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@opentui/core": "0.5.9",
    "@opentui/solid": "0.5.9",
    "solid-js": "1.9.12"
  },
  "optionalDependencies": {
    "@oven/bun-darwin-aarch64": "1.3.14",
    "@oven/bun-darwin-x64": "1.3.14",
    "@oven/bun-linux-aarch64": "1.3.14",
    "@oven/bun-linux-x64": "1.3.14",
    "@oven/bun-linux-x64-musl": "1.3.14",
    "@oven/bun-windows-aarch64": "1.3.14",
    "@oven/bun-windows-x64": "1.3.14"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "js-yaml": "^5.3.0",
    "typescript": "^5.5.0"
  }
}
