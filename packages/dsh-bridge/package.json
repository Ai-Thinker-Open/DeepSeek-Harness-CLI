{
  "name": "@dsh/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dsh-bridge": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "tui": "bun run src/tui.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --outdir dist --target node --format esm",
    "build:tui": "bun build src/tui.ts --outdir dist --target node --format esm",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
